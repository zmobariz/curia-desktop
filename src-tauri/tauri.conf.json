{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curia",
  "version": "0.1.0",
  "identifier": "org.curia.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Curia \u2014 UK legislation research",
        "width": 1120,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREOTcyOUFGNTE0OUJDRDUKUldUVnZFbFJyeW1YM1pTUGQ3QndsbGtzbHVseXdWTFdEQ1ZsQStISXV2bHBwZ3Z6UnNVNmRGcVQK",
      "endpoints": [
        "https://github.com/zmobariz/curia-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "The Curia maintainers",
    "shortDescription": "Search UK legislation via the i.AI Lex API.",
    "longDescription": "A portable desktop client for searching UK legislation through the UK Government's i.AI Lex API. No admin rights required. Optional AI explanations using your own API key.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
